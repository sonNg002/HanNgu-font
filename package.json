{
  "name": "hanngu-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "content:build": "tsx scripts/build-content.ts",
    "build": "npm run content:build && next build && node scripts/build-sw.mjs",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "predev": "npm run content:build",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "12.19.0",
    "hanzi-writer": "^3.7.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "hanzi-writer-data": "^2.0.1",
    "serve": "^14.2.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "1.14.6",
    "compression": "1.8.2"
  }
}
